{
	"name": "chicago-reader/chicago-reader-plugin",
	"description": "Chicago Reader custom functionality for the Newspack platform.",
	"license": "GPL-2.0-or-later",
	"require": {
		"stripe/stripe-php": "21.3.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "*",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.6",
		"wp-coding-standards/wpcs": "^3.0",
		"automattic/vipwpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "*"
	},
	"scripts": {
		"build": [
			"composer install --no-dev --optimize-autoloader"
		],
		"dev": [
			"composer install"
		],
		"lint": "./vendor/bin/phpcs --standard=phpcs.xml -n",
		"test": "./vendor/bin/phpunit"
	},
	"autoload": {
		"psr-4": {
			"ChicagoReader\\": "inc/"
		},
		"files": []
	},
	"config": {
		"platform": {
			"php": "8.0"
		},
		"allow-plugins": {
			"squizlabs/php_codesniffer": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"wp-coding-standards/wpcs": true
		}
	}
}
